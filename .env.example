# Copy to .env and fill in. Never commit .env.
# Generate a secret:  python -c "import secrets;print(secrets.token_hex(32))"

SECRET_KEY=replace_me
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=deepfake_defence

# Set to 1 only when served over HTTPS
COOKIE_SECURE=0

# Kali VM bridge. The URL is the VM's host-only adapter address.
KALI_AGENT_URL=http://192.168.56.10:7000
KALI_AGENT_TOKEN=replace_me_same_value_as_AGENT_TOKEN_in_kali

# Optional: comma-separated Hugging Face model IDs used for image deepfake
# detection. Each is averaged together; a model that fails to download or
# load is skipped rather than crashing the app. Default: a CVPR 2025,
# peer-reviewed model (2.7M images, 4,803 generators) plus a community
# fine-tune — see the top of detector.py for citations and known caveats
# before adding or swapping models in.
DEEPFAKE_HF_MODELS=buildborderless/CommunityForensics-DeepfakeDet-ViT,dima806/deepfake_vs_real_image_detection

# Optional: Hugging Face model ID used for audio deepfake detection.
DEEPFAKE_AUDIO_HF_MODEL=MelodyMachine/Deepfake-audio-detection-V2
