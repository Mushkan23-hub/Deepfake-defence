# Copy to .env and fill in. Never commit .env.
# Generate a secret:  python -c "import secrets;print(secrets.token_hex(32))"

SECRET_KEY=replace_me
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=deepfake_defence

# Set to 1 only when served over HTTPS
COOKIE_SECURE=0

# Kali VM bridge. The URL is the VM's host-only adapter address.
KALI_AGENT_URL=http://192.168.56.10:7000
KALI_AGENT_TOKEN=replace_me_same_value_as_AGENT_TOKEN_in_kali

# Optional: path to fine-tuned deepfake weights. Without this the classifier
# head is untrained and the app falls back to heuristics only.
DEEPFAKE_WEIGHTS=weights/deepfake_effb4.pt
